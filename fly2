-- Keyboard support (desktop)
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Space then goingUp = true end
    if input.KeyCode == Enum.KeyCode.LeftControl then goingDown = true end
    if input.KeyCode == Enum.KeyCode.F then toggleFly() end
    if input.KeyCode == Enum.KeyCode.N then
        setNoclip(not noclipping)
        if noclipping then
            noclipBtn.Text = "Noclip: ON"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
        else
            noclipBtn.Text = "Noclip: OFF"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Space then goingUp = false end
    if input.KeyCode == Enum.KeyCode.LeftControl then goingDown = false end
end)

